!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.npm-cache/
.venv/
.python-version
__pycache__/
*.pyc
*.pyo
*.pyd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
